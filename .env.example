# BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Vergul bilan: botdan foydalanishi mumkin bo'lgan Telegram ID'lar.
# O'z ID'ingizni bilmasangiz, botga /start yozing: bot ko'rsatadi.
ALLOWED_USER_IDS=
# setup.ps1 avtomatik to'ldiradi
DATABASE_URL=postgresql://nakladnoy:PAROL@127.0.0.1:5433/nakladnoy
# Modellar (ixtiyoriy)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=medium
# Zaxira: Gemini limiti tugasa yoki ishlamasa (ixtiyoriy). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
