// QORALAMA. 1C'DA SINALMAGAN.
// Bot chiqargan CSV'ni o'qib, "Поступление материалов" hujjatlarini YARATADI, lekin PROVODKA QILMAYDI.
// Tashqi obrabotka (.epf) moduliga qo'yiladi. Oldin albatta nusxa (test) bazada sinang.
//
// Skrinshotda metadata nomlari ko'rinmaydi, shuning uchun quyidagilar TAXMIN.
// Konfiguratorda aniq nomlarni tekshirib, shu qatorlarni moslang:
//   Документы.ПоступлениеМатериалов        - hujjat nomi
//   Справочники.Контрагенты, .ИНН          - kontragent va uning INN rekviziti
//   Справочники.ДоговорыКонтрагентов       - shartnoma (Владелец = kontragent)
//   Справочники.Материалы                  - material katalogi
//   Справочники.Подразделения              - bo'linma
//   Hujjat rekvizitlari: Дата, Контрагент, Договор, Подразделение, НомерВходящегоДокумента,
//                        ДатаВходящегоДокумента, Комментарий
//   Jadval qismi Материалы: Материал, Количество, Цена, Сумма
//   Valyuta, НДС stavkasi va Биржевая, agar majburiy bo'lsa, shu yerga qo'shiladi.

Функция ПрочитатьCSV(ИмяФайла)
	Текст = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Строки = Новый Массив;
	Заголовки = Неопределено;
	Строка = Текст.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Поля = РазобратьСтроку(Строка);
		Если Заголовки = Неопределено Тогда
			Заголовки = Поля;
		Иначе
			Запись = Новый Соответствие;
			Для Индекс = 0 По Мин(Заголовки.ВГраница(), Поля.ВГраница()) Цикл
				Запись.Вставить(Заголовки[Индекс], Поля[Индекс]);
			КонецЦикла;
			Строки.Добавить(Запись);
		КонецЕсли;
		Строка = Текст.ПрочитатьСтроку();
	КонецЦикла;
	Текст.Закрыть();
	Возврат Строки;
КонецФункции

// CSV qoidasi: ';' ajratadi, qo'shtirnoq ichidagi ';' ajratmaydi, "" esa bitta ".
// Izohda qator ko'chishi bo'lsa, bu oddiy o'quvchi uni qo'llamaydi: botda izohni bir qatorda yozing.
Функция РазобратьСтроку(Строка)
	Поля = Новый Массив;
	Буфер = "";
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Строка);
	Пока Индекс <= Длина Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ = """" Тогда
			Если ВКавычках И Сред(Строка, Индекс + 1, 1) = """" Тогда
				Буфер = Буфер + """";
				Индекс = Индекс + 1;
			Иначе
				ВКавычках = Не ВКавычках;
			КонецЕсли;
		ИначеЕсли Символ = ";" И Не ВКавычках Тогда
			Поля.Добавить(Буфер);
			Буфер = "";
		Иначе
			Буфер = Буфер + Символ;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Поля.Добавить(Буфер);
	Возврат Поля;
КонецФункции

Функция ДатаИзТекста(Текст)
	// "03.11.2026 12:00:00" yoki "03.11.2026"
	Д = Лев(Текст, 2); М = Сред(Текст, 4, 2); Г = Сред(Текст, 7, 4);
	Время = ?(СтрДлина(Текст) >= 19, СтрЗаменить(Сред(Текст, 12, 8), ":", ""), "000000");
	Возврат Дата(Г + М + Д + Время);
КонецФункции

// Asosiy kirish. Natija: yaratilgan hujjatlar soni; xatolar Сообщить orqali chiqadi.
// Bir xil Ключ документа Комментарий ichida saqlanadi: fayl qayta yuklansa, hujjat ikkilanmaydi.
Функция ЗагрузитьФайл(ИмяФайла) Экспорт
	Строки = ПрочитатьCSV(ИмяФайла);
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Запись Из Строки Цикл
		Ключ = Запись["Ключ документа"];
		Если Группы[Ключ] = Неопределено Тогда
			Группы.Вставить(Ключ, Новый Массив);
			Порядок.Добавить(Ключ);
		КонецЕсли;
		Группы[Ключ].Добавить(Запись);
	КонецЦикла;

	Создано = 0;
	Для Каждого Ключ Из Порядок Цикл
		Если СоздатьДокумент(Ключ, Группы[Ключ]) Тогда
			Создано = Создано + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Создано;
КонецФункции

Функция СоздатьДокумент(Ключ, Записи)
	Метка = "[" + Ключ + "]";
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Документ.ПоступлениеМатериалов КАК Д
		|ГДЕ Д.Комментарий ПОДОБНО &Метка");
	Запрос.УстановитьПараметр("Метка", "%" + Метка + "%");
	Если Не Запрос.Выполнить().Пустой() Тогда
		Сообщить(Ключ + ": allaqachon yuklangan, o'tkazildi");
		Возврат Ложь;
	КонецЕсли;

	Шапка = Записи[0];
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Шапка["ИНН"]);
	Если Контрагент.Пустая() Тогда
		Сообщить(Ключ + ": kontragent topilmadi, ИНН " + Шапка["ИНН"]);
		Возврат Ложь;
	КонецЕсли;
	Договор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(Шапка["Договор"], Истина, , Контрагент);
	Если Договор.Пустая() Тогда
		Сообщить(Ключ + ": shartnoma topilmadi: " + Шапка["Договор"]);
		Возврат Ложь;
	КонецЕсли;

	Док = Документы.ПоступлениеМатериалов.СоздатьДокумент();
	Док.Дата = ДатаИзТекста(Шапка["Date"]);
	Док.Контрагент = Контрагент;
	Док.Договор = Договор;
	Док.Подразделение = Справочники.Подразделения.НайтиПоНаименованию(Шапка["Подразделение"], Истина);
	Док.НомерВходящегоДокумента = Шапка["№ вх.док-та"];
	Док.ДатаВходящегоДокумента = ДатаИзТекста(Шапка["Дата вх.док-та"]);
	Док.Комментарий = СокрЛП(Шапка["Комментарий"] + " " + Метка);

	Для Каждого Запись Из Записи Цикл
		Материал = Справочники.Материалы.НайтиПоНаименованию(Запись["Материал"], Истина);
		Если Материал.Пустая() Тогда
			Сообщить(Ключ + ": material topilmadi: " + Запись["Материал"]);
			Возврат Ложь;
		КонецЕсли;
		Строка = Док.Материалы.Добавить();
		Строка.Материал = Материал;
		Строка.Количество = Число(Запись["Количество"]);
		Строка.Цена = Число(Запись["Цена"]);
		Строка.Сумма = Число(Запись["Сумма"]);
	КонецЦикла;

	// Faqat yozish. Provodka hisobchi tekshirganidan keyin, qo'lda.
	Док.Записать(РежимЗаписиДокумента.Запись);
	Сообщить(Ключ + ": yaratildi");
	Возврат Истина;
КонецФункции
